# Your Gorgias subdomain (the part before .gorgias.com). Used both to call
# the Gorgias API and to build ticket links in the dashboard.
NEXT_PUBLIC_GORGIAS_SUBDOMAIN=

# Gorgias REST API credentials (Settings > REST API in Gorgias).
GORGIAS_EMAIL=
GORGIAS_API_KEY=

# Random secret used by NextAuth to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# OAuth client credentials from the Google Cloud Console (APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google account emails allowed to sign in.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Full URL of the deployed app, used by NextAuth to build correct callback URLs.
AUTH_URL=https://prowldesk.vercel.app
