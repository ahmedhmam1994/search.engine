# Base URL of the CodeWords runtime that executes the backing workflow.
CODEWORDS_RUNTIME_URI=https://runtime.codewords.ai

# Bearer token used to authenticate server-to-server calls to CodeWords.
CODEWORDS_API_KEY=

# Random secret used by NextAuth to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# OAuth client credentials from the Google Cloud Console (APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google account emails allowed to sign in.
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: your Gorgias subdomain (the part before .gorgias.com). If set,
# ticket IDs in the dashboard link directly to the ticket in Gorgias.
NEXT_PUBLIC_GORGIAS_SUBDOMAIN=
